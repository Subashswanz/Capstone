# Analyze the uploaded Jupyter notebook and build a quick outline + metadata
import nbformat, re, os, json
from collections import Counter, defaultdict
import pandas as pd
from pathlib import Path
from caas_jupyter_tools import display_dataframe_to_user

nb_path = "/mnt/data/Capstone_Project_Final.ipynb"
assert os.path.exists(nb_path), "Notebook file not found at /mnt/data/Capstone_Project_Final.ipynb"

nb = nbformat.read(nb_path, as_version=4)

cells = nb.get("cells", [])
n_cells = len(cells)
n_code = sum(1 for c in cells if c["cell_type"] == "code")
n_md = sum(1 for c in cells if c["cell_type"] == "markdown")
n_raw = sum(1 for c in cells if c["cell_type"] == "raw")

# Extract markdown headings
headings = []
for i, c in enumerate(cells):
    if c["cell_type"] == "markdown":
        lines = c["source"].splitlines()
        for ln in lines:
            m = re.match(r"^(#{1,6})\s+(.*)", ln.strip())
            if m:
                level = len(m.group(1))
                text = m.group(2).strip()
                # remove trailing hashes
                text = re.sub(r"\s*#+\s*$", "", text).strip()
                headings.append({"cell_index": i, "level": level, "heading": text})

# Extract imports from code cells
import_re = re.compile(r"^\s*(?:from\s+([\w\.]+)\s+import|import\s+([\w\.\, \\\n]+))", re.MULTILINE)
libs = []
for c in cells:
    if c["cell_type"] == "code":
        src = c["source"]
        for m in import_re.finditer(src):
            raw = m.group(0)
            # Normalize: split by commas/lines and take first token of each import
            if "import " in raw:
                # handle `import a, b as c` and `from x import y`
                parts = re.findall(r"(?:from\s+([\w\.]+)\s+import)|(?:import\s+([A-Za-z0-9_\.\s,]+))", raw)
            # simpler approach: collect words after 'import' and 'from'
        # More robust simple regex for libs
        for lib in re.findall(r"^\s*(?:from|import)\s+([A-Za-z0-9_\.]+)", src, flags=re.MULTILINE):
            libs.append(lib.split(".")[0])

lib_counts = Counter(libs)
top_libs = lib_counts.most_common()

# Find likely data file references in code (simple heuristic for strings that look like paths or filenames)
file_pattern = re.compile(r"""(['"])([^'"]+\.(csv|parquet|json|xlsx|xls|txt|tsv|sav|pkl|pickle))\1""", re.IGNORECASE)
paths = []
for i, c in enumerate(cells):
    if c["cell_type"] == "code":
        for m in file_pattern.finditer(c["source"]):
            paths.append({"cell_index": i, "file": m.group(2)})

# Build an outline dataframe
outline_rows = []
for i, c in enumerate(cells):
    ctype = c["cell_type"]
    src = c["source"]
    # summarize first non-empty line (strip markdown headers and code comments)
    summary = ""
    for line in src.splitlines():
        ln = line.strip()
        if not ln:
            continue
        if ctype == "markdown":
            ln = re.sub(r"^#{1,6}\s*", "", ln).strip()
            if not ln:
                continue
        if ctype == "code":
            if ln.startswith("#"):
                ln = ln.lstrip("#").strip()
                if not ln:
                    continue
        summary = ln[:140]
        break
    outline_rows.append({"cell_index": i, "type": ctype, "summary": summary})

outline_df = pd.DataFrame(outline_rows)
display_dataframe_to_user("Notebook Outline (cells)", outline_df)

# Headings dataframe
headings_df = pd.DataFrame(headings)
if not headings_df.empty:
    display_dataframe_to_user("Markdown Headings", headings_df)

# Libraries dataframe
libs_df = pd.DataFrame(top_libs, columns=["library", "count"])
if not libs_df.empty:
    display_dataframe_to_user("Imported Libraries (frequency)", libs_df)

# Referenced files dataframe
paths_df = pd.DataFrame(paths)
if not paths_df.empty:
    display_dataframe_to_user("Referenced Data Files (best-guess)", paths_df)

# Also save a lightweight README-style outline as markdown for download
md_lines = []
md_lines.append(f"# Capstone Notebook Quick Outline\n")
md_lines.append(f"- Total cells: {n_cells} (code: {n_code}, markdown: {n_md}, raw: {n_raw})\n")
if top_libs:
    md_lines.append("## Top imported libraries\n")
    for lib, cnt in top_libs[:25]:
        md_lines.append(f"- {lib}: {cnt}")
    md_lines.append("")
if headings:
    md_lines.append("## Headings\n")
    for h in headings:
        md_lines.append(f"{'  '*(h['level']-1)}- {h['heading']} (cell {h['cell_index']})")
    md_lines.append("")
# add a short cell list
md_lines.append("## Cells (first line preview)\n")
for row in outline_rows[:200]:  # cap to first 200 entries
    md_lines.append(f"- [{row['type']}] cell {row['cell_index']}: {row['summary']}")
md_text = "\n".join(md_lines)

out_path = "/mnt/data/Capstone_Notebook_Outline.md"
with open(out_path, "w", encoding="utf-8") as f:
    f.write(md_text)

out_path
